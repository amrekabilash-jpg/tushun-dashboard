# Скопируй в .env и заполни (для production — в Railway env vars)

# development | production | testing
FLASK_ENV=development

# Локально не задавать → fallback на sqlite:///dashboard.db
# Production (Supabase): postgresql://postgres:PASSWORD@xxxxx.supabase.co:5432/postgres
# DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/DB

# JWT секрет — обязательно поменять в production
JWT_SECRET=tushun-dev-secret-change-me

# Только в production: список origins для CORS через запятую
# FRONTEND_URLS=https://tushun.vercel.app,https://tushun-dashboard.vercel.app

# Railway автоматически подставит свой PORT, локально не нужен
# PORT=5000
